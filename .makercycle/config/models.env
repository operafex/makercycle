# ==============================================================================
# MAKERCYCLE — VARIÁVEIS DE CONTROLE DE MODELOS E SKILLS
# Edite este arquivo para trocar ou testar modelos sem alterar o código Go.
# ==============================================================================

# ==============================================================================
# Recomendação de Arquitetura: Cross-Auditing (Multi-LLM)
# Utilize até 5 modelos diferentes, um por etapa com LLM (PLANNER, CRITIC, MAKER, AUDITOR, GATEKEEPER).
# Use no mínimo 2 provedores distintos, por exemplo: Anthropic para MAKER e OpenAI/Gemini para GATEKEEPER.
# Quem escreve o código não deve ser quem o julga: isso evita viés de confirmação.
# As chaves de API (ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY) NUNCA ficam neste arquivo versionado:
# declare-as em .makercycle/config/project.env (ignorado pelo Git, modo 0600).
# ==============================================================================

# AUTENTICAÇÃO E FALLBACK OMNIROUTE
#MC_AUTH_MODE="api_key"
MC_AUTH_MODE="api_key"
MC_OMNIROUTE_ENABLED="false"
MC_OMNIROUTE_URL="http://localhost:20128"
# Placeholder de instância local do OmniRoute (não é um segredo).
MC_OMNIROUTE_API_KEY="omniroute-local"
MC_OMNIROUTE_MODEL="claude-sonnet-4-6"

# ETAPA 0 — SCAN (Onboarding de projetos já existentes)
MC_SCOUT_BIN=claude
MC_SCOUT_MODEL=opus
# Argumentos extras do CLI (opcional, separados por espaço). Necessários para o modo headless (-p)
# conseguir gravar arquivos / rodar testes sem bloquear em prompt de permissão.
MC_SCOUT_ARGS=--permission-mode acceptEdits

# ETAPA 1 — PLAN (Planejamento incremental + criação de testes RED)
MC_PLANNER_BIN=claude
MC_PLANNER_MODEL=opus
MC_PLANNER_SKILL=obra/superpowers
# ATENÇÃO: --dangerously-skip-permissions desativa TODOS os prompts de permissão do Claude Code.
# Use apenas em repositório confiável / ambiente isolado.
MC_PLANNER_ARGS=--dangerously-skip-permissions

# ETAPA 2 — CHALLENGE (Revisão crítica a frio + invariantes globais)
MC_CRITIC_BIN=gemini
MC_CRITIC_MODEL=gemini-3.1-pro-preview
MC_CRITIC_SKILL=google/elephant-goldfish-model
MC_CRITIC_ARGS=--yolo --skip-trust

# ETAPA 3 — MAKE (Execução rápida em contexto higienizado)
MC_MAKER_BIN=claude
MC_MAKER_MODEL=sonnet
MC_MAKER_ARGS=--dangerously-skip-permissions

# ETAPA 4B — VERIFY: HARDEN (Auditoria de segurança no git diff)
MC_AUDITOR_BIN=gemini
MC_AUDITOR_MODEL=gemini-3.1-pro-preview
MC_AUDITOR_SKILL=cloudflare/security-audit-skill
MC_AUDITOR_ARGS=--yolo --skip-trust

# ETAPA 5 — GATE (Juiz semântico final + Circuit Breaker)
MC_GATEKEEPER_BIN=gemini
MC_GATEKEEPER_MODEL=gemini-3.1-pro-preview
MC_GATEKEEPER_ARGS=--yolo --skip-trust

# As variáveis MC_*_SKILL usam o identificador completo "dono/repositório": `./makercycle -init` instala as ausentes (npx skills add <skill> -g -y).

# CONTROLE DO LOOP & DOCUMENTAÇÃO
MC_MAX_ATTEMPTS=3
MC_DEFAULT_DOCS_DIR=docs

